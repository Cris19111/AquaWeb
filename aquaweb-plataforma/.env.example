# ============================================================================
# AquaWeb IoT — Configuración de Entorno (.env.example)
# ============================================================================

# --- Base de datos PostgreSQL 16 (Local o Cloud Managed) ---
POSTGRES_DB=aquaweb_iot
POSTGRES_USER=aquaweb
POSTGRES_PASSWORD=aquaweb_secret_2026
POSTGRES_PORT=5435
DATABASE_URL=postgresql+psycopg://aquaweb:aquaweb_secret_2026@localhost:5435/aquaweb_iot

# --- Broker MQTT (broker público por defecto para Wokwi o Mosquitto local) ---
MQTT_BROKER_HOST=broker.hivemq.com
MQTT_BROKER_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_KEEPALIVE_SEG=15
MQTT_GRUPO=grupo
MQTT_DEVICE_ID=estanque-01
MQTT_ENABLED=true

# --- Supervisión, Calidad de Datos y Alertas ---
DEFAULT_PUB_INTERVAL_SEG=5
SILENCE_MULTIPLIER=3
FROZEN_SENSOR_CYCLES=5
COMMAND_TIMEOUT_SEG=15
ALERT_RESOLVE_CYCLES=3
BUFFER_FILE_PATH=backend/data/buffer_pendiente.jsonl

# --- Seguridad API & CORS (GitHub Pages + Local) ---
API_KEY=aquaweb-dev-key-2026
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://cris19111.github.io
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
